# ── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # anon/public key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key — server-only, never exposed to the client

# ── Admin panel (custodian) ────────────────────────────────
# Comma-separated list of emails allowed into /custodian
ADMIN_EMAILS=you@example.com

# ── Resend ──────────────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address — must be a domain verified in Resend
# For testing you can use: onboarding@resend.dev
FROM_EMAIL=selci <noreply@selci.org>

# ── Stripe ──────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Cron (Vercel) ───────────────────────────────────────────
# Protegge /api/cron/release-expired-orders — Vercel invia questo stesso
# valore come header Authorization quando richiamato dal cron (vercel.json).
CRON_SECRET=
